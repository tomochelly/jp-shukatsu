---
import BaseLayout from '~/layouts/BaseLayout.astro';
import GuideCard from '~/components/GuideCard.astro';
import { getGuides } from '~/lib/guides';

const guides = await getGuides();
---
<BaseLayout title="가이드" description="일본 취업 구조, 용어, 졸업 연도별 일정, 비자 기초를 한국어로 정리한 글.">
  <h1>가이드</h1>
  <p class="lead">
    일본 취업 사이트를 쓰기 전에 알아두면 좋은 내용을 한국어로 정리해요. 일본어 용어는 원문을 같이 적어요.
  </p>
  <ul class="list">{guides.map((g) => <GuideCard guide={g} />)}</ul>
</BaseLayout>

<style>
  h1 {
    font-size: var(--fs-xl);
  }
  .lead {
    max-width: var(--measure);
    margin: var(--sp-2) 0 var(--sp-6);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .list {
    max-width: 720px;
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--border);
  }
</style>
