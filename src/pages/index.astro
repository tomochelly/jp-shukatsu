---
import BaseLayout from '~/layouts/BaseLayout.astro';
import TrackPicker from '~/components/TrackPicker.astro';
import SectionHead from '~/components/SectionHead.astro';
import EventList from '~/components/EventList.astro';
import StatusChip from '~/components/StatusChip.astro';
import { getCompanyData } from '~/lib/companies';
import { IMMINENT_DAYS } from '~/lib/dates';
import GuideCard from '~/components/GuideCard.astro';
import { getGuides } from '~/lib/guides';

const data = await getCompanyData();
const guides = await getGuides();
const targets = [...new Set(data.industries.map((i) => i.targetYearLabel))].join(', ');
---
<BaseLayout>
  <section class="tracks" aria-labelledby="tracks-title">
    <h1 id="tracks-title">나는 어떤 경우?</h1>
    <p class="lead">상황에 따라 준비 순서가 달라요. 해당하는 쪽을 골라주세요.</p>
    <TrackPicker meta={{ new: `${targets} · 가이드 ${guides.filter((g) => g.data.tracks.includes('new')).length} · 기업 ${data.companies.length}` }} />
  </section>

  <div class="cols">
    <section aria-labelledby="upcoming-title">
      <SectionHead id="upcoming-title" title="다가오는 일정" href="/calendar/" linkLabel="캘린더 전체" />
      <EventList events={data.events} upcomingLimit={5} emptyText="지금은 다가오는 일정이 없어요." />
      <p class="legend">
        <StatusChip tone="danger" label="마감 임박" /> {IMMINENT_DAYS}일 이내
        <StatusChip tone="ok" label="진행 중" /> 응모 기간 안
        <span class="tz">· 일본 시간 기준</span>
      </p>
    </section>

    <section aria-labelledby="guides-title">
      <SectionHead id="guides-title" title="가이드" href="/guides/" />
      <ul class="guides">{guides.slice(0, 4).map((g) => <GuideCard guide={g} compact />)}</ul>
    </section>
  </div>
</BaseLayout>

<style>
  h1 {
    font-size: var(--fs-xl);
    letter-spacing: -0.02em;
  }
  .lead {
    margin: var(--sp-1) 0 var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .cols {
    display: grid;
    gap: var(--sp-10);
    margin-top: var(--sp-10);
  }
  @media (min-width: 960px) {
    .cols {
      grid-template-columns: minmax(0, 1fr) 300px;
    }
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
    font-size: var(--fs-xs);
    color: var(--text-faint);
  }
  .guides {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--border);
  }
</style>
