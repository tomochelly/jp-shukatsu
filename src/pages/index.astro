---
// 1단계 확인용 임시 홈. 4단계에서 시안 기준 홈으로 교체.
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout>
  <h1 class="tmp-title">나는 어떤 경우?</h1>
  <p class="tmp-text">레이아웃 골격 확인용 페이지입니다. 홈 화면은 4단계에서 만듭니다.</p>
</BaseLayout>

<style>
  .tmp-title {
    font-size: var(--fs-xl);
  }
  .tmp-text {
    margin-top: var(--sp-2);
    color: var(--text-muted);
  }
</style>
