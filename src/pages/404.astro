---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { NAV } from '~/lib/site';
---
<BaseLayout title="페이지를 찾을 수 없어요" noindex>
  <div class="nf">
    <p class="code num">404</p>
    <h1>페이지를 찾을 수 없어요</h1>
    <p class="lead">
      주소가 바뀌었거나 아직 만들지 않은 페이지예요. 채용 정보는 매년 바뀌어서 지난 연도 페이지를 정리했을 수도 있어요.
    </p>
    <ul class="links">
      {NAV.map((n) => (
        <li><a href={n.href}>{n.label}</a></li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .nf {
    max-width: var(--measure);
    padding-block: var(--sp-8);
  }
  .code {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--text-faint);
    letter-spacing: 0.08em;
  }
  h1 {
    margin-top: var(--sp-2);
    font-size: var(--fs-xl);
  }
  .lead {
    margin-top: var(--sp-3);
    color: var(--text-muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-6);
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-block;
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }
  .links a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
