---
/** 본문 안 안내 상자. warn: 이전 연도 요강 등 주의 / info: 참고 */
interface Props {
  tone?: 'warn' | 'info';
  title?: string;
}
const { tone = 'warn', title } = Astro.props;
---
<div class:list={['notice', `notice--${tone}`]} role="note">
  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
    {tone === 'warn' ? (
      <>
        <path d="M7 1.5 13 12.5H1z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
        <path d="M7 5.5v3M7 10.2v.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      </>
    ) : (
      <>
        <circle cx="7" cy="7" r="5.75" fill="none" stroke="currentColor" stroke-width="1.4" />
        <path d="M7 6.2v3.6M7 4.2v.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      </>
    )}
  </svg>
  <div>
    {title && <strong>{title}</strong>} <slot />
  </div>
</div>

<style>
  .notice {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-2);
    align-items: start;
    margin-top: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    border-left: 3px solid var(--tone);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--tone-soft);
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
  }
  .notice--warn { --tone: var(--warn); --tone-soft: var(--warn-soft); }
  .notice--info { --tone: var(--accent); --tone-soft: var(--accent-soft); }
  svg {
    color: var(--tone);
    margin-top: 3px;
  }
  strong {
    color: var(--tone);
    font-weight: var(--fw-semibold);
  }
</style>
